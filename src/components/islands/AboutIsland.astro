---
import { tinaField } from '@tinacms/astro';

interface Props {
	about: any;
}

const { about } = Astro.props;
---

<span id="main-content" />

<section class="pt-24 pb-16 max-[720px]:pt-16 max-[720px]:pb-12" >
	<p class="m-0 font-mono text-[0.82rem] font-semibold tracking-[0.08em] leading-[1.4] uppercase text-[var(--muted-foreground)] not-italic">About</p>
	<div class="grid grid-cols-[minmax(0,1.35fr)_minmax(15rem,20rem)] gap-10 items-start mt-4 max-[1100px]:grid-cols-1 max-[1100px]:gap-7">
		<div class="max-w-[52rem] max-[1100px]:max-w-full">
			<h1 class="display-title" data-tina-field={tinaField(about, 'heroTitle')}>{about.heroTitle}</h1>
			<p
				class="max-w-[44rem] mt-6 text-[1.08rem] leading-[1.7] m-0 max-[1100px]:max-w-[42rem] max-[720px]:text-[1.05rem]"
				data-tina-field={tinaField(about, 'heroText')}
			>{about.heroText}</p>
		</div>
	</div>
</section>

{about.sections?.map((section: any) => (
	<section class="grid grid-cols-[16rem_minmax(0,1fr)] gap-8 py-10 border-t border-[var(--border)] max-[720px]:grid-cols-1">
		<div class="self-start">
			<p
				class="m-0 font-mono text-[0.82rem] font-semibold tracking-[0.08em] leading-[1.4] uppercase text-[var(--muted-foreground)] not-italic"
				data-tina-field={tinaField(section, 'kicker')}
			>{section.kicker}</p>
		</div>
		<div class="grid gap-4 max-w-[52rem]" data-tina-field={tinaField(section, 'body')}>
			{section.body.split('\n\n').filter(Boolean).map((para: string) => (
				<p class="text-[1.08rem] leading-[1.7] m-0 max-[720px]:text-[1.05rem]">{para.trim()}</p>
			))}
		</div>
	</section>
))}
