---
import { tinaField } from '@tinacms/astro';

interface Props {
	projects: any[];
	workPage?: any;
}

const { projects, workPage } = Astro.props;
const workPageSize = 6;
const sorted = [...(projects ?? [])].sort((a, b) => (Number(a.order) || 0) - (Number(b.order) || 0));
const page = 1;
const totalPages = Math.ceil(sorted.length / workPageSize);
const visibleProjects = sorted.slice(0, workPageSize);
---

<span id="main-content" />

<header class="max-w-full pt-[4.5rem] max-[720px]:pt-16">
	<p
		class="m-0 font-mono text-[0.82rem] font-semibold tracking-[0.08em] leading-[1.4] uppercase text-[var(--muted-foreground)] not-italic"
		data-tina-field={workPage ? tinaField(workPage, 'eyebrow') : undefined}
	>{workPage?.eyebrow ?? 'Selected work'}</p>
	<h1
		class="m-0 mt-4 font-extrabold tracking-[-0.05em] text-[var(--foreground)] text-[clamp(2.6rem,4.6vw,4.4rem)] leading-[1.03]"
		data-tina-field={workPage ? tinaField(workPage, 'headline') : undefined}
	>{workPage?.headline ?? 'Projects built to make complex things feel clear, useful, and easier to trust.'}</h1>
</header>

<section class="grid gap-6 mt-12" aria-label="Project list">
	{
		visibleProjects.map((project: any) => (
			<article class="grid grid-cols-[minmax(0,0.9fr)_minmax(22rem,1.1fr)] gap-8 items-start p-6 bg-[var(--card)] border border-[var(--border)] rounded-3xl max-[860px]:grid-cols-1 max-[860px]:gap-5 max-[720px]:p-5">
				<div class="grid items-start gap-[0.8rem]">
					<p
						class="m-0 font-mono text-[0.82rem] font-semibold tracking-[0.08em] leading-[1.4] uppercase text-[var(--muted-foreground)] not-italic"
						data-tina-field={tinaField(project, 'name')}
					>{project.name}</p>
					<h2
						class="m-0 font-extrabold tracking-[-0.05em] text-[var(--foreground)] text-[clamp(1.6rem,2.1vw,2.2rem)] leading-[1.08]"
						data-tina-field={tinaField(project, 'title')}
					>{project.title}</h2>
					<p
						class="text-[1.05rem] leading-[1.75] text-[var(--muted-foreground)] max-w-[34rem] m-0"
						data-tina-field={tinaField(project, 'description')}
					>{project.description}</p>

					<div class="flex mt-2">
						<a
							class="inline-flex items-center justify-center gap-[0.6rem] min-h-[48px] px-[1.1rem] border border-[var(--control-border)] rounded-full text-[1rem] font-bold text-inherit no-underline transition-[transform,border-color,background-color] duration-[120ms] ease-[ease] hover:-translate-y-px hover:bg-[var(--muted)] hover:border-[var(--border-strong)] focus-visible:-translate-y-px focus-visible:bg-[var(--muted)] focus-visible:border-[var(--border-strong)]"
							href={`/work/${project.slug}`}
						>
							<span>View case study</span>
							<span aria-hidden="true">-&gt;</span>
						</a>
					</div>
				</div>

				<a class="block p-0 rounded-2xl no-underline self-start" href={`/work/${project.slug}`}>
					<img
						class={project.imageClass}
						src={project.image}
						alt={project.alt}
						loading="lazy"
						decoding="async"
					/>
				</a>
			</article>
		))
	}
</section>

{totalPages > 1 && (
	<nav class="flex gap-3 justify-center mt-8" aria-label="Works pagination">
		{Array.from({ length: totalPages }, (_, index) => {
			const pageNumber = index + 1;
			const href = pageNumber === 1 ? '/work' : `/work/page/${pageNumber}`;
			const isCurrent = page === pageNumber;
			return (
				<a
					class:list={[
						'inline-flex items-center justify-center w-[3.25rem] h-[3.25rem] border rounded-full text-[1rem] font-bold no-underline transition-[transform,border-color,background-color] duration-[120ms] ease-[ease]',
						isCurrent
							? 'bg-[var(--foreground)] border-[var(--foreground)] text-[var(--background)] hover:translate-y-0 focus-visible:translate-y-0'
							: 'border-[var(--control-border)] text-inherit hover:-translate-y-px hover:bg-[var(--muted)] hover:border-[var(--border-strong)] focus-visible:-translate-y-px',
					]}
					href={href}
					aria-current={isCurrent ? 'page' : undefined}
				>
					{pageNumber}
				</a>
			);
		})}
	</nav>
)}
