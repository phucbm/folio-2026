---
import Layout from '../../layouts/Layout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import { siteConfig } from '../../config/site';
import { requestWithMetadata, tinaField } from '@tinacms/astro';
import client from '../../../tina/__generated__/client';

const { slug } = Astro.params;
const relativePath = `${slug}.md`;
const projectRes = await requestWithMetadata(client.queries.projects({ relativePath }));
const project = projectRes.data.projects;

const highlights = [
	{ label: 'Client', value: project.metaClient },
	{ label: 'Industry', value: project.metaIndustry },
	{ label: 'Region', value: project.metaRegion },
].filter((h) => h.value);

const caseStudyUrl = new URL(`/work/${project.slug}`, siteConfig.siteUrl).toString();
const caseStudySchema = [
	{
		'@context': 'https://schema.org',
		'@type': 'BreadcrumbList',
		itemListElement: [
			{ '@type': 'ListItem', position: 1, name: 'Home', item: siteConfig.siteUrl },
			{ '@type': 'ListItem', position: 2, name: 'Work', item: new URL('/work', siteConfig.siteUrl).toString() },
			{ '@type': 'ListItem', position: 3, name: `${project.name} Case Study`, item: caseStudyUrl },
		],
	},
	{
		'@context': 'https://schema.org',
		'@type': 'CreativeWork',
		name: `${project.name} Case Study`,
		url: caseStudyUrl,
		author: { '@type': 'Person', name: siteConfig.authorName },
		isPartOf: { '@type': 'WebSite', name: siteConfig.name, url: siteConfig.siteUrl },
		inLanguage: siteConfig.locale,
	},
];
---

<Layout
	title={`${project.name} Case Study | ${siteConfig.authorName}`}
	description={project.caseText ?? project.description}
	ogType="article"
	schema={caseStudySchema}
>
	<a class="skip-link" href="#main-content">Skip to content</a>

	<div class="case-page">
		<SiteHeader />

		<TinaIsland name="project" wrapper={{ tag: 'main', className: undefined }} params={{ relativePath: `${project.slug}.md` }} primary>
			<span id="main-content" />

			<section class="case-hero">
				<p class="eyebrow">
					<a class="breadcrumb-link" href="/work">Case Study</a>
					<span class="breadcrumb-separator" aria-hidden="true">/</span>
					<span>{project.name}</span>
				</p>
				<h1 class="display-title" data-tina-field={tinaField(project, 'caseTitle')}>{project.caseTitle ?? project.title}</h1>
				<div class="hero-subgrid">
					<p class="hero-text" data-tina-field={tinaField(project, 'caseText')}>{project.caseText ?? project.description}</p>
				</div>
			</section>

			{highlights.length > 0 && (
				<section class="meta-strip" id="overview">
					{highlights.map((item) => (
						<div class="meta-item">
							<p class="meta-label">{item.label}</p>
							<p class="meta-value">{item.value}</p>
						</div>
					))}
				</section>
			)}

			{project.image && (
				<section class="lead-image-section">
					<img
						class="lead-image"
						src={project.image}
						alt={project.alt ?? project.name}
						decoding="async"
						loading="eager"
					/>
				</section>
			)}

			<section class="updating-section">
				<p class="updating-label">Case study updating</p>
				<p class="updating-text">Full case study content coming soon. Check back shortly for the complete breakdown of process, design decisions, and outcomes.</p>
			</section>
		</TinaIsland>
	</div>
</Layout>

<style>
	.case-page {
		position: relative;
		width: min(calc(100% - 3rem), 78rem);
		margin: 0 auto;
		padding: 1.25rem 0 5rem;
	}

	.eyebrow,
	.meta-label {
		font-family: var(--font-mono);
		font-size: 0.82rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		line-height: 1.4;
		text-transform: uppercase;
	}

	.eyebrow a {
		display: inline-flex;
		align-items: center;
		padding: 0.1rem 0;
		color: var(--foreground);
		text-decoration: none;
		transition: opacity 120ms ease;
	}

	.eyebrow a:hover,
	.eyebrow a:focus-visible {
		opacity: 0.68;
	}

	.case-hero {
		padding: 6rem 0 4rem;
	}

	.eyebrow,
	.meta-label {
		margin: 0;
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.55rem;
		margin-bottom: 1.1rem;
		color: var(--muted-foreground);
		font-style: normal;
	}

	.breadcrumb-link {
		font-weight: 600;
	}

	.breadcrumb-separator {
		color: var(--muted-foreground);
	}

	h1 {
		margin: 0;
		font-weight: 800;
		letter-spacing: -0.05em;
		color: var(--foreground);
	}

	.hero-subgrid {
		display: grid;
		grid-template-columns: minmax(0, 1.3fr) minmax(0, 0.7fr);
		gap: 2rem;
		margin-top: 1.75rem;
	}

	.hero-text {
		font-size: 1.08rem;
		line-height: 1.7;
		margin: 0;
	}

	.meta-strip {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 2rem;
		padding: 1.5rem 0 0.5rem;
		border-top: 1px solid var(--border);
	}

	.meta-item {
		padding-top: 0.75rem;
	}

	.meta-value {
		margin: 0.35rem 0 0;
		font-size: 1.15rem;
		font-weight: 700;
	}

	.lead-image-section {
		padding: 2rem 0 4rem;
	}

	.lead-image {
		width: 100%;
		border: 1px solid var(--border);
		border-radius: 1.5rem;
		box-shadow: var(--shadow-large);
	}

	.updating-section {
		padding: 3rem 0 2rem;
		border-top: 1px solid var(--border);
	}

	.updating-label {
		margin: 0 0 0.75rem;
		font-family: var(--font-mono);
		font-size: 0.82rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--muted-foreground);
	}

	.updating-text {
		margin: 0;
		font-size: 1.08rem;
		line-height: 1.7;
		color: var(--muted-foreground);
		max-width: 42rem;
	}

	@media (max-width: 980px) {
		.hero-subgrid,
		.meta-strip {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 720px) {
		.case-page {
			width: min(calc(100% - 1.5rem), 78rem);
			padding-top: 1rem;
		}

		.case-hero {
			padding: 4rem 0 3rem;
		}

		.hero-text {
			font-size: 1.05rem;
		}
	}
</style>
