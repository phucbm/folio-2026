---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
---

<Layout
	title="About Phuc Bui — AI Engineer & Frontend Developer"
	description="Phuc Bui — AI Engineer, Frontend Developer, and founder of Perxel. Building motion-rich, AI-informed websites since 2018."
>
	<a class="skip-link" href="#main-content">Skip to content</a>

	<div class="page">
		<SiteHeader />

		<main id="main-content">
			<section class="hero">
				<p class="eyebrow">About</p>
				<div class="hero-layout">
					<div class="hero-copy">
						<h1 class="display-title">I build motion-rich, AI-informed websites that actually ship.</h1>
						<p class="hero-text">
							I'm Phuc, an AI Engineer and Frontend Developer running Perxel — a web studio
							where animation meets intelligence. I've been writing production web code since 2018.
						</p>
					</div>
				</div>
			</section>

			<section class="editorial-section">
				<div class="section-rail">
					<p class="section-kicker">Background</p>
				</div>
				<div class="story-block">
					<p>
						Started as a frontend developer, grew into leading teams, now running my own studio.
						Previously Frontend Team Lead at ViiVue. Founded Perxel to build the kind of websites
						I actually want to make — fast, animated, AI-powered.
					</p>
					<p>
						I've worked across WordPress, Next.js, and custom web architecture for clients ranging
						from luxury resorts to tech startups across Vietnam and beyond.
					</p>
				</div>
			</section>

			<section class="editorial-section">
				<div class="section-rail">
					<p class="section-kicker">How I Work</p>
				</div>
				<div class="story-block">
					<p>
						I care about craft at every layer: smooth GSAP animations, clean component APIs,
						AI integrations that add real value rather than gimmicks, and deployment pipelines
						that don't break at 2am.
					</p>
					<p>
						Most of my open-source work is production-tested — built for real projects,
						then extracted and published. If I ship it, I've run it in production first.
					</p>
				</div>
			</section>

			<section class="editorial-section">
				<div class="section-rail">
					<p class="section-kicker">Focus</p>
				</div>
				<div class="story-block">
					<p>
						AI engineering and web animation. Building tools with Claude, integrating RAG pipelines,
						and creating GSAP-powered component libraries. Currently deep in AI API integration,
						generative UI, and motion-first design systems.
					</p>
					<p>
						Also maintaining several open-source packages — Chrome extensions, React components,
						jQuery plugins — used by thousands of developers.
					</p>
				</div>
			</section>
		</main>
	</div>
</Layout>

<style>
	.page {
		position: relative;
		width: min(calc(100% - 3rem), 78rem);
		margin: 0 auto;
		padding: 1.25rem 0 5rem;
	}

	.eyebrow,
	.section-kicker {
		font-family: var(--font-mono);
		font-size: 0.82rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		line-height: 1.4;
		text-transform: uppercase;
	}

	.hero {
		padding: 6rem 0 4rem;
	}

	.hero-layout {
		display: grid;
		grid-template-columns: minmax(0, 1.35fr) minmax(15rem, 20rem);
		gap: 2.5rem;
		align-items: start;
		margin-top: 1rem;
	}

	.hero-copy {
		max-width: 52rem;
	}

	.eyebrow,
	.section-kicker {
		margin: 0;
		color: var(--muted-foreground);
		font-style: normal;
	}

	.hero-text,
	.story-block p {
		font-size: 1.08rem;
		line-height: 1.7;
		margin: 0;
	}

	.hero-text {
		max-width: 44rem;
		margin-top: 1.5rem;
	}

	.hero-portrait-wrap {
		display: flex;
		justify-content: flex-end;
		align-self: start;
		padding-top: 0.35rem;
	}

	.hero-portrait {
		width: min(100%, 20rem);
		height: auto;
		display: block;
		border-radius: 1.5rem;
		box-shadow: 0 18px 40px rgba(23, 23, 23, 0.08);
	}

	.editorial-section {
		display: grid;
		grid-template-columns: 16rem minmax(0, 1fr);
		gap: 2rem;
		padding: 2.5rem 0;
		border-top: 1px solid var(--border);
	}

	.section-rail {
		align-self: start;
	}

	.story-block {
		display: grid;
		gap: 1rem;
		max-width: 52rem;
	}

	@media (max-width: 1100px) {
		.hero-layout {
			grid-template-columns: 1fr;
			gap: 1.75rem;
			align-items: start;
		}

		.hero-copy {
			max-width: 100%;
		}

		.hero-text {
			max-width: 42rem;
		}

		.hero-portrait-wrap {
			justify-content: flex-start;
			padding-top: 0;
		}
	}

	@media (max-width: 720px) {
		.page {
			width: min(calc(100% - 1.5rem), 78rem);
			padding-top: 1rem;
		}

		.hero {
			padding: 4rem 0 3rem;
		}

		.editorial-section {
			grid-template-columns: 1fr;
		}

		.hero-text,
		.story-block p {
			font-size: 1.05rem;
		}

		.hero-portrait {
			width: min(100%, 16rem);
		}
	}
</style>
