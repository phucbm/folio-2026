---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import { requestWithMetadata } from '@tinacms/astro';
import ResumeIsland from '../components/islands/ResumeIsland.astro';
import client from '../../tina/__generated__/client';

const resumeRes = await requestWithMetadata(client.queries.resume({ relativePath: 'index.md' }));
const resume = resumeRes.data.resume;
---

<Layout
	title="Resume — Phuc Bui"
	description="Phuc Bui's resume. Frontend Engineer based in Ho Chi Minh City. Delivering production websites and AI tools."
>
	<a class="skip-link" href="#main-content">Skip to content</a>

	<div class="relative w-[min(calc(100%-3rem),78rem)] mx-auto py-5 pb-20 max-[720px]:w-[min(calc(100%-1.5rem),78rem)] max-[720px]:pt-4">
		<SiteHeader />

		<TinaIsland name="resume" wrapper={{ tag: 'main', className: undefined }} primary>
			<ResumeIsland resume={resume} />
		</TinaIsland>
	</div>
</Layout>
