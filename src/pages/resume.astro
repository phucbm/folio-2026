---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';

const stack = [
	'HTML5 / CSS3 / Vanilla JS', 'TypeScript', 'React', 'Next.js',
	'WordPress / Gutenberg', 'Tailwind CSS', 'CSS Animation',
	'MCP / Claude API', 'OpenRouter', 'Langfuse',
	'Vite', 'Vitest', 'GitHub Actions', 'Vercel',
];

const clients = [
	'REE Corp', 'Long An International Port', 'RMIT Vietnam',
	'Sky Preschool', 'Tam Coc Garden', 'Mia Nha Trang', 'The Deck Saigon',
	'Growtrics', 'DMD by Sun Group', 'Koru Education',
];
---

<Layout
	title="Resume — Phuc Bui"
	description="Phuc Bui's resume. Frontend Engineer based in Ho Chi Minh City. Delivering production websites and AI tools."
>
	<a class="skip-link" href="#main-content">Skip to content</a>

	<div class="page">
		<SiteHeader />

		<main id="main-content">
			<section class="hero">
				<p class="eyebrow">Resume</p>
				<h1 class="display-title">Frontend engineer. Production websites, open-source libraries, AI integration.</h1>
				<div class="hero-subgrid">
					<p class="hero-text">
						Shipped 300+ production sites. Now building AI tools.
					</p>
				</div>
			</section>

			<section class="editorial-section">
				<div class="section-rail">
					<p class="section-kicker">Snapshot</p>
				</div>
				<div class="story-block">
					<p><strong>Location:</strong> Ho Chi Minh City, Vietnam</p>
					<p><strong>Focus:</strong> Frontend Engineering / AI Integration</p>
					<p><strong>Availability:</strong> Open to hybrid or remote</p>
					<p><strong>Contact:</strong> <a href="mailto:phucbm.dev@gmail.com">phucbm.dev@gmail.com</a></p>
				</div>
			</section>

			<section class="editorial-section">
				<div class="section-rail">
					<p class="section-kicker">Experience</p>
				</div>
				<div class="story-block">
					<p>
						<strong>Frontend Engineer — Perxel Studio</strong><br />
						Apr 2022 – Present
					</p>
					<p>
						Built production websites for international clients — Growtrics.ai (Singapore EdTech), DMD by Sun Group — on WordPress and Next.js. Owns full delivery end to end: architecture, performance, cross-browser QA, and Vercel deployment.
					</p>
					<p>
						<strong>Lead Frontend Engineer — ViiVue</strong><br />
						Sep 2017 – May 2025
					</p>
					<p>
						Delivered 300+ production websites across enterprise, education, and hospitality. Proposed and led jQuery-to-vanilla-JS migration; built the custom component libraries that replaced it. Introduced atomic-css, an in-house utility system adopted across all projects. Led a 5+ person team: CI/CD migration to GitHub Actions, code review standards, internal documentation.
					</p>
				</div>
			</section>

			<section class="editorial-section">
				<div class="section-rail">
					<p class="section-kicker">Stack</p>
				</div>
				<div class="tags-grid">
					{stack.map((item) => (
						<span class="tag">{item}</span>
					))}
				</div>
			</section>

			<section class="editorial-section">
				<div class="section-rail">
					<p class="section-kicker">Clients</p>
				</div>
				<div class="tags-grid">
					{clients.map((item) => (
						<span class="tag">{item}</span>
					))}
				</div>
			</section>

		</main>
	</div>
</Layout>

<style>
	.page {
		position: relative;
		width: min(calc(100% - 3rem), 78rem);
		margin: 0 auto;
		padding: 1.25rem 0 5rem;
	}

	.eyebrow,
	.section-kicker {
		font-family: var(--font-mono);
		font-size: 0.82rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		line-height: 1.4;
		text-transform: uppercase;
	}

	.hero {
		padding: 6rem 0 4rem;
	}

	.eyebrow,
	.section-kicker {
		margin: 0;
		color: var(--muted-foreground);
		font-style: normal;
	}

	.hero-subgrid {
		display: grid;
		grid-template-columns: 1fr;
		margin-top: 1.75rem;
	}

	.hero-text,
	.story-block p {
		font-size: 1.08rem;
		line-height: 1.7;
		margin: 0;
	}

	.editorial-section {
		display: grid;
		grid-template-columns: 16rem minmax(0, 1fr);
		gap: 2rem;
		padding: 2.5rem 0;
		border-top: 1px solid var(--border);
	}

	.section-rail {
		align-self: start;
	}

	.story-block {
		display: grid;
		gap: 1rem;
		max-width: 52rem;
	}

	.story-block strong {
		color: var(--foreground);
	}

	.tags-grid {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
		max-width: 52rem;
	}

	.tag {
		display: inline-flex;
		align-items: center;
		padding: 0.35rem 0.75rem;
		border: 1px solid var(--border);
		border-radius: 999px;
		font-size: 0.9rem;
		font-weight: 500;
		background: var(--card);
		color: var(--foreground);
	}

	@media (max-width: 980px) {
		.hero-subgrid {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 720px) {
		.page {
			width: min(calc(100% - 1.5rem), 78rem);
			padding-top: 1rem;
		}

		.hero {
			padding: 4rem 0 3rem;
		}

		.editorial-section {
			grid-template-columns: 1fr;
		}

		.hero-text,
		.story-block p {
			font-size: 1.05rem;
		}

		.tools-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
