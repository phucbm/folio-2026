---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';

const stack = [
	'Next.js', 'React', 'TypeScript', 'WordPress',
	'GSAP', 'Web Animation', 'Tailwind CSS', 'shadcn/ui',
	'Claude / Anthropic', 'Generative AI', 'RAG', 'AI APIs',
	'Figma', 'Node.js', 'Astro', 'Vercel',
];

const clients = [
	'Growtrics', 'REE Corp', 'RMIT Experience Day', 'DTA Luxury',
	'Khatra', 'MOOI', 'Tam Coc Garden Resort', 'Mia Nha Trang',
	'Mia Saigon', 'Yadea Vietnam', 'Long An Intl Port', 'HotCross',
];
---

<Layout
	title="Resume — Phuc Bui"
	description="Phuc Bui's resume. AI Engineer and Frontend Developer with 7+ years building production web products."
>
	<a class="skip-link" href="#main-content">Skip to content</a>

	<div class="page">
		<SiteHeader />

		<main id="main-content">
			<section class="hero">
				<p class="eyebrow">Resume</p>
				<h1 class="display-title">7+ years building production web products across animation, AI, and frontend engineering.</h1>
				<div class="hero-subgrid">
					<p class="hero-text">
						From jQuery plugins to RAG pipelines. I write code that ships, scales, and moves.
					</p>
				</div>
			</section>

			<section class="editorial-section">
				<div class="section-rail">
					<p class="section-kicker">Snapshot</p>
				</div>
				<div class="story-block">
					<p><strong>Location:</strong> Vietnam</p>
					<p><strong>Focus:</strong> AI Engineering / Frontend Development</p>
					<p><strong>Specialties:</strong> Web animation, AI integration, production architecture</p>
					<p><strong>Contact:</strong> <a href="mailto:phucbm.dev@gmail.com">phucbm.dev@gmail.com</a></p>
				</div>
			</section>

			<section class="editorial-section">
				<div class="section-rail">
					<p class="section-kicker">Experience</p>
				</div>
				<div class="story-block">
					<p>
						<strong>Founder / CEO — Perxel</strong><br />
						Web Studio, 2022 – Present
					</p>
					<p>
						Building motion-rich, AI-informed websites. Running client projects and open-source tools in parallel.
					</p>
					<p>
						<strong>Frontend Team Lead — ViiVue</strong><br />
						2019 – 2022
					</p>
					<p>
						Led frontend architecture and team. Built reusable component systems, tooling, and
						shipped production web products for enterprise clients.
					</p>
					<p>
						<strong>Frontend Developer</strong><br />
						Freelance / Agencies, 2018 – 2019
					</p>
					<p>
						WordPress and React development for hospitality, luxury, and tech clients across Vietnam.
					</p>
				</div>
			</section>

			<section class="editorial-section">
				<div class="section-rail">
					<p class="section-kicker">Stack</p>
				</div>
				<div class="tags-grid">
					{stack.map((item) => (
						<span class="tag">{item}</span>
					))}
				</div>
			</section>

			<section class="editorial-section">
				<div class="section-rail">
					<p class="section-kicker">Clients</p>
				</div>
				<div class="tags-grid">
					{clients.map((item) => (
						<span class="tag">{item}</span>
					))}
				</div>
			</section>
		</main>
	</div>
</Layout>

<style>
	.page {
		position: relative;
		width: min(calc(100% - 3rem), 78rem);
		margin: 0 auto;
		padding: 1.25rem 0 5rem;
	}

	.eyebrow,
	.section-kicker {
		font-family: var(--font-mono);
		font-size: 0.82rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		line-height: 1.4;
		text-transform: uppercase;
	}

	.hero {
		padding: 6rem 0 4rem;
	}

	.eyebrow,
	.section-kicker {
		margin: 0;
		color: var(--muted-foreground);
		font-style: normal;
	}

	.hero-subgrid {
		display: grid;
		grid-template-columns: 1fr;
		margin-top: 1.75rem;
	}

	.hero-text,
	.story-block p {
		font-size: 1.08rem;
		line-height: 1.7;
		margin: 0;
	}

	.editorial-section {
		display: grid;
		grid-template-columns: 16rem minmax(0, 1fr);
		gap: 2rem;
		padding: 2.5rem 0;
		border-top: 1px solid var(--border);
	}

	.section-rail {
		align-self: start;
	}

	.story-block {
		display: grid;
		gap: 1rem;
		max-width: 52rem;
	}

	.story-block strong {
		color: var(--foreground);
	}

	.tags-grid {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
		max-width: 52rem;
	}

	.tag {
		display: inline-flex;
		align-items: center;
		padding: 0.35rem 0.75rem;
		border: 1px solid var(--border);
		border-radius: 999px;
		font-size: 0.9rem;
		font-weight: 500;
		background: var(--card);
		color: var(--foreground);
	}

	@media (max-width: 980px) {
		.hero-subgrid {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 720px) {
		.page {
			width: min(calc(100% - 1.5rem), 78rem);
			padding-top: 1rem;
		}

		.hero {
			padding: 4rem 0 3rem;
		}

		.editorial-section {
			grid-template-columns: 1fr;
		}

		.hero-text,
		.story-block p {
			font-size: 1.05rem;
		}

		.tools-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
